# Local MySQL connection used by the FastAPI backend. Production rejects root/blank credentials.
AD_META_ENVIRONMENT=development
AD_META_DB_ENGINE=mysql
AD_META_MYSQL_HOST=127.0.0.1
AD_META_MYSQL_PORT=3306
AD_META_MYSQL_USER=ad_meta
AD_META_MYSQL_PASSWORD=your-local-password
AD_META_MYSQL_DATABASE=ad_meta
AD_META_STATS_WORKER_URL=http://127.0.0.1:8001
# Comma-separated browser origins for deployments that do not use a same-origin proxy.
AD_META_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Rebuildable MySQL projection JSON cache policy.
AD_META_PROJECTION_CACHE_TTL_HOURS=168
AD_META_PROJECTION_FILE_CACHE_MAX_ENTRY_BYTES=67108864
AD_META_PROJECTION_FILE_CACHE_MAX_TOTAL_BYTES=536870912
AD_META_PROJECTION_FILE_CACHE_MAX_FILES=5000
# MAG dataset key identifies the imported cohort result.
# Independent GMrepo reference package. Default runtime ZIP is shipped under data-packages/.
# Relative paths resolve against the repository root; manifests and source evidence are checked at read time.
AD_META_GMREPO_DATA_ROOT=ADMetaData/reference/gmrepo/processed/2026-10-09-v1
AD_META_MAG_DATASET=prjca022804-ad-nc
