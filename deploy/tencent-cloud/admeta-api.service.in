[Unit]
Description=AD-Meta FastAPI
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=admeta
Group=admeta
WorkingDirectory=@@APP_ROOT@@/backend
Environment=PYTHONUNBUFFERED=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
ExecStartPre=@@APP_ROOT@@/backend/.venv/bin/python -c "from app.core.database import get_engine; get_engine().connect().close()"
ExecStart=@@APP_ROOT@@/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
